generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão com pool (pgbouncer) — é a que a aplicação usa em serverless.
  url      = env("DATABASE_URL")
  // Conexão direta, exigida pelas migrations (que não funcionam via pgbouncer).
  directUrl = env("DIRECT_URL")
}

/// Imagem de uma peça, guardada no próprio banco em vez de no filesystem
/// (serverless não tem disco persistente). Fica numa tabela separada de propósito:
/// assim listar figuras nunca traz os bytes junto. As figuras referenciam a
/// imagem pela URL `/api/imagem/<id>`, servida por app/api/imagem/[id]/route.ts.
model Imagem {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model Figure {
  id            String   @id @default(cuid())
  nome          String
  personagem    String
  linha         String?
  escala        String
  estilo        String
  alinhamento   String
  tipo          String
  status        String
  precoEstimado Float?
  faixaPreco    String
  link          String?
  imagemUrl     String?
  // Miniatura gerada no upload; a imagem cheia só é servida no detalhe/lightbox.
  thumbUrl      String?
  observacoes   String?
  // Data simples da última conferência de preço (não é histórico de preço).
  precoConferidoEm DateTime?
  // Soft delete: exclusão vai pra "lixeira" e pode ser desfeita. Toda leitura
  // filtra por `deletedAt: null` — ver notDeleted() em lib/queries.ts.
  deletedAt     DateTime?

  // Ficha de Poder: notas de 1 a 7 dadas pelo usuário, no formato dos
  // handbooks antigos. Nulo = ainda não avaliado.
  articulacao   Int?
  pintura       Int?
  acessorios    Int?
  semelhanca    Int?
  raridade      Int?

  // Momento em que a peça saiu da wishlist e entrou na coleção. Alimenta o
  // "tempo de caçada" — quanto tempo você perseguiu a peça.
  conquistadaEm DateTime?

  // Cobiça na wishlist: "alta" | "media" | "baixa".
  prioridade    String?

  // Era da HQ do personagem (Ouro, Prata, Bronze, Moderna).
  era           String?

  // Cadastro relâmpago: entra só com nome e foto, completa depois.
  rascunho      Boolean   @default(false)

  // Cor dominante extraída da foto no upload (hex), para o filtro por paleta.
  corDominante  String?

  // Altura real em cm, para comparação de escala.
  alturaCm      Float?
  marcaId       String
  marca         Marca      @relation(fields: [marcaId], references: [id])
  grupoId       String
  grupo         Grupo      @relation(fields: [grupoId], references: [id])
  conjuntos     Conjunto[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Marca {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  figures Figure[]
}

model Grupo {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  /// Total alvo do grupo, quando você sabe o tamanho do set mesmo sem ter
  /// catalogado tudo. Vazio = o alvo é o total de peças já catalogadas.
  meta    Int?
  /// Nome do ícone (lucide) exibido junto da badge do grupo.
  icone   String?
  figures Figure[]
}

// Agrupamento pessoal dentro da Coleção: uma figura pode pertencer a vários
// conjuntos (ex: "Display da estante", "Diorama Homem-Aranha"), diferente do
// campo Grupo (afiliação única, ex: Avengers/X-Men).
model Conjunto {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  /// Total alvo do conjunto (ver Grupo.meta).
  meta    Int?
  figures Figure[]
}

// Listas simples configuraveis: escala, estilo, alinhamento, tipo, status, faixaPreco
model Option {
  id        String @id @default(cuid())
  categoria String
  valor     String
  corBg     String
  corFg     String
  ordem     Int    @default(0)

  @@unique([categoria, valor])
}

/// Preferências do app. Tabela de uma linha só (id fixo "singleton") — é um
/// app single-user, então não há a quem associar a configuração.
model Preferencias {
  id              String   @id @default("singleton")
  nomeColecao     String?
  tema            String   @default("obsidian")
  densidade       Int      @default(5)
  orcamentoMensal Float?
  graoPapel       Boolean  @default(false)
  somAmbiente     Boolean  @default(false)
  atualizadoEm    DateTime @updatedAt
}

/// Usuário do painel. O app é single-user, mas a tabela permite trocar a senha
/// sem redeploy — o que uma variável de ambiente com hash não permitiria.
model Usuario {
  id        String    @id @default(cuid())
  login     String    @unique
  senhaHash String
  criadoEm  DateTime  @default(now())
  sessoes   Sessao[]
}

/// Sessão persistida. O cookie carrega só o token opaco; validade e revogação
/// vivem aqui, então dá pra encerrar sessão em todos os aparelhos.
model Sessao {
  token      String   @id
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm   DateTime
  criadaEm   DateTime @default(now())
  ultimoUso  DateTime @default(now())

  @@index([usuarioId])
}
