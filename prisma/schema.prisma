generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexão com pool (pgbouncer) — é a que a aplicação usa em serverless.
  url      = env("DATABASE_URL")
  // Conexão direta, exigida pelas migrations (que não funcionam via pgbouncer).
  directUrl = env("DIRECT_URL")
}

/// Imagem de uma peça, guardada no próprio banco em vez de no filesystem
/// (serverless não tem disco persistente). Fica numa tabela separada de propósito:
/// assim listar figuras nunca traz os bytes junto. As figuras referenciam a
/// imagem pela URL `/api/imagem/<id>`, servida por app/api/imagem/[id]/route.ts.
model Imagem {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model Figure {
  id            String   @id @default(cuid())
  nome          String
  personagem    String
  linha         String?
  escala        String
  estilo        String
  alinhamento   String
  tipo          String
  status        String
  precoEstimado Float?
  faixaPreco    String
  link          String?
  imagemUrl     String?
  // Miniatura gerada no upload; a imagem cheia só é servida no detalhe/lightbox.
  thumbUrl      String?
  observacoes   String?
  // Data simples da última conferência de preço (não é histórico de preço).
  precoConferidoEm DateTime?
  // Soft delete: exclusão vai pra "lixeira" e pode ser desfeita. Toda leitura
  // filtra por `deletedAt: null` — ver notDeleted() em lib/queries.ts.
  deletedAt     DateTime?
  marcaId       String
  marca         Marca      @relation(fields: [marcaId], references: [id])
  grupoId       String
  grupo         Grupo      @relation(fields: [grupoId], references: [id])
  conjuntos     Conjunto[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Marca {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  figures Figure[]
}

model Grupo {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  figures Figure[]
}

// Agrupamento pessoal dentro da Coleção: uma figura pode pertencer a vários
// conjuntos (ex: "Display da estante", "Diorama Homem-Aranha"), diferente do
// campo Grupo (afiliação única, ex: Avengers/X-Men).
model Conjunto {
  id      String   @id @default(cuid())
  nome    String   @unique
  corBg   String
  corFg   String
  ordem   Int      @default(0)
  figures Figure[]
}

// Listas simples configuraveis: escala, estilo, alinhamento, tipo, status, faixaPreco
model Option {
  id        String @id @default(cuid())
  categoria String
  valor     String
  corBg     String
  corFg     String
  ordem     Int    @default(0)

  @@unique([categoria, valor])
}
