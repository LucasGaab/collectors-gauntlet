# Copie para .env e preencha com as strings do seu projeto na Neon.
#
# DATABASE_URL  -> connection string COM pool (o host tem "-pooler").
#                  É a que a aplicação usa; serverless abre muitas conexões
#                  curtas e sem pgbouncer o Postgres estoura o limite.
# DIRECT_URL    -> connection string SEM pool. Só as migrations usam, porque
#                  pgbouncer não suporta os comandos que o Prisma emite nelas.
#
# As duas saem prontas no painel da Neon (Connection Details).

DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"
